# Copy to .env.local for local development.
#
# Renamed from the Vite build's VITE_* prefix — Next.js only exposes variables
# prefixed NEXT_PUBLIC_ to the browser. Both must also be set in the Vercel
# project settings before the new deployment goes live.

# Was: VITE_API_URL
NEXT_PUBLIC_API_URL=https://ash-ali-backend.vercel.app/api

# Was: VITE_SITE_URL — referenced by src/constants/site.ts but never actually
# set in the old .env, so it silently fell back to the production origin.
# Setting it explicitly makes canonical/OG URL generation deterministic.
NEXT_PUBLIC_SITE_URL=https://www.ashali.com

# Mailer credentials for contact & newsletter API routes (set in Vercel project settings)
# MAIL_USER=your-email@example.com
# MAIL_PASS=your-app-password
# CONTACT_OWNER_EMAIL=ash@ashali.com
